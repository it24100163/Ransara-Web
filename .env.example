# /.env.example — Copy to .env and fill in real values before running
# ⚠️  NEVER commit .env to version control. .env is in .gitignore.

# ── PostgreSQL ──────────────────────────────────────────────────────────────────
POSTGRES_USER=admin
POSTGRES_PASSWORD=your_secure_db_password
POSTGRES_DB=grocery_management

# DATABASE_URL is constructed from the variables above (used by Docker Compose)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# ── Admin Seed Account ─────────────────────────────────────────────────────────
ADMIN_FIRSTNAME=Market
ADMIN_LASTNAME=Admin
ADMIN_PASSWORD=your_secure_admin_password_min_16_chars
ADMIN_EMAIL=admin@yourdomain.com

# ── Auth ────────────────────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_64_character_secure_random_hex_string_here_replace_this

# ── Public URLs (used for PayHere callbacks & CORS) ────────────────────────────
# Set to the publicly reachable URL of each service (no trailing slash)
BACKEND_PUBLIC_URL=http://localhost:8000
FRONTEND_PUBLIC_URL=http://localhost:3000

# ── Frontend API Base URL ───────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000

# ── Google Services ─────────────────────────────────────────────────────────────
# Google OAuth 2.0 Client — https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_AUTH_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_AUTH_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_AUTH_CLIENT_SECRET=your_google_oauth_client_secret
# Google Maps JavaScript API key
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ── Gemini AI (ChatBot) ─────────────────────────────────────────────────────────
# Get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key
# Optional: comma-separated list for key rotation (overrides GEMINI_API_KEY)
# GEMINI_API_KEYS=key1,key2,key3

# ── PayHere Payment Gateway ─────────────────────────────────────────────────────
# Obtain from https://www.payhere.lk/merchants/settings/domains
PAYHERE_MERCHANT_ID=your_payhere_merchant_id
PAYHERE_MERCHANT_SECRET=your_payhere_merchant_secret_base64
PAYHERE_SECRET=your_payhere_api_secret
PayHere_APP_ID=your_payhere_app_id
# Set to "true" for sandbox testing, "false" for live production
PAYHERE_SANDBOX=true

# Never insert demo/historical products automatically
AUTO_SEED_HISTORICAL_DATA=false
